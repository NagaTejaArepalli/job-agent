# AI Job Search & Application Agent Configuration

# LLM Intelligence Provider (options: heuristic, gemini, openai)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Scheduler Settings (Daily discovery at 08:00 AM UTC)
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
SCHEDULER_ENABLED=True

# Browser Automation (Set to False to see Playwright browser window in real-time)
HEADLESS_BROWSER=False
